#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_CONFIG_EDITOR DIALOGEX 0, 0, 500, 405
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
CAPTION "MCP Server Configuration"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_TAB_SETTINGS, WC_TABCONTROL, WS_TABSTOP, 8, 8, 484, 338

    GROUPBOX        "Server", IDC_SERVER_GROUP, 20, 38, 460, 100
    LTEXT           "Bind address", IDC_LABEL_SERVER_ADDRESS, 34, 62, 86, 10
    EDITTEXT        IDC_SERVER_ADDRESS, 126, 59, 336, 14, ES_AUTOHSCROLL
    LTEXT           "Port", IDC_LABEL_SERVER_PORT, 34, 86, 86, 10
    EDITTEXT        IDC_SERVER_PORT, 126, 83, 88, 14, ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX    "Start MCP HTTP server when the plugin loads", IDC_FEATURE_AUTOSTART, 34, 110, 290, 10

    GROUPBOX        "Security", IDC_SECURITY_GROUP, 20, 38, 460, 282
    LTEXT           "Browser and proxy allowlists", IDC_LABEL_SECURITY_ALLOWLISTS, 34, 58, 180, 10
    LTEXT           "Allowed origins (one per line)", IDC_LABEL_SECURITY_ORIGINS, 34, 76, 180, 10
    EDITTEXT        IDC_SECURITY_ORIGINS, 34, 89, 428, 38, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Allowed hosts (one per line)", IDC_LABEL_SECURITY_HOSTS, 34, 138, 180, 10
    EDITTEXT        IDC_SECURITY_HOSTS, 34, 151, 428, 38, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bearer authentication", IDC_LABEL_SECURITY_AUTH, 34, 204, 160, 10
    AUTOCHECKBOX    "Require token", IDC_AUTH_ENABLED, 34, 222, 120, 10
    LTEXT           "Token", IDC_LABEL_AUTH_TOKEN, 162, 224, 38, 10
    EDITTEXT        IDC_AUTH_TOKEN, 204, 221, 258, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Use authentication and TLS for non-loopback listeners.", IDC_LABEL_SECURITY_HINT, 34, 254, 350, 10

    GROUPBOX        "Debugger Permissions", IDC_PERMISSIONS_GROUP, 20, 38, 460, 116
    AUTOCHECKBOX    "Allow memory writes", IDC_ALLOW_MEMORY_WRITE, 34, 62, 210, 10
    AUTOCHECKBOX    "Allow register writes", IDC_ALLOW_REGISTER_WRITE, 34, 82, 210, 10
    AUTOCHECKBOX    "Allow script execution", IDC_ALLOW_SCRIPT_EXEC, 34, 102, 210, 10
    AUTOCHECKBOX    "Allow breakpoint modification", IDC_ALLOW_BREAKPOINT_MOD, 34, 122, 210, 10
    GROUPBOX        "Allowed Method Patterns", IDC_METHODS_GROUP, 20, 164, 460, 156
    LISTBOX         IDC_METHODS_LIST, 34, 184, 428, 84, LBS_STANDARD | WS_VSCROLL | WS_TABSTOP
    LTEXT           "New pattern", IDC_LABEL_METHOD_PATTERN, 34, 284, 76, 10
    EDITTEXT        IDC_METHOD_INPUT, 116, 281, 218, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Add", IDC_METHOD_ADD, 344, 279, 54, 18
    PUSHBUTTON      "Remove", IDC_METHOD_REMOVE, 408, 279, 54, 18

    GROUPBOX        "Runtime", IDC_TIMEOUT_GROUP, 20, 38, 460, 214
    LTEXT           "Timeouts (milliseconds)", IDC_LABEL_RUNTIME_TIMEOUTS, 34, 60, 145, 10
    LTEXT           "Request", IDC_LABEL_TIMEOUT_REQUEST, 34, 82, 72, 10
    EDITTEXT        IDC_TIMEOUT_REQUEST, 110, 79, 96, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Step", IDC_LABEL_TIMEOUT_STEP, 34, 106, 72, 10
    EDITTEXT        IDC_TIMEOUT_STEP, 110, 103, 96, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Memory read", IDC_LABEL_TIMEOUT_MEMORY, 34, 130, 72, 10
    EDITTEXT        IDC_TIMEOUT_MEMORY, 110, 127, 96, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Features", IDC_LABEL_RUNTIME_FEATURES, 260, 60, 100, 10
    AUTOCHECKBOX    "Notifications", IDC_FEATURE_NOTIFICATIONS, 260, 84, 150, 10
    AUTOCHECKBOX    "Heartbeat", IDC_FEATURE_HEARTBEAT, 260, 108, 150, 10
    LTEXT           "Interval (s)", IDC_LABEL_HEARTBEAT_INTERVAL, 260, 134, 72, 10
    EDITTEXT        IDC_HEARTBEAT_INTERVAL, 338, 131, 72, 14, ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX    "Batch requests", IDC_FEATURE_BATCH, 260, 160, 150, 10

    GROUPBOX        "Logging", IDC_LOGGING_GROUP, 20, 38, 460, 142
    AUTOCHECKBOX    "Enable logging", IDC_LOG_ENABLED, 34, 62, 150, 10
    AUTOCHECKBOX    "Console output", IDC_LOG_CONSOLE, 250, 62, 150, 10
    LTEXT           "Level", IDC_LABEL_LOG_LEVEL, 34, 92, 56, 10
    COMBOBOX        IDC_LOG_LEVEL, 96, 89, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Maximum MB", IDC_LABEL_LOG_MAX_SIZE, 250, 92, 82, 10
    EDITTEXT        IDC_LOG_MAX_SIZE, 340, 89, 70, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Log file", IDC_LABEL_LOG_FILE, 34, 122, 56, 10
    EDITTEXT        IDC_LOG_FILE, 96, 119, 366, 14, ES_AUTOHSCROLL

    LTEXT           "Restart the MCP HTTP server to apply changes.", IDC_FOOTER_STATUS, 16, 365, 300, 12
    DEFPUSHBUTTON   "Save", IDOK, 370, 361, 56, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 434, 361, 56, 20
END
